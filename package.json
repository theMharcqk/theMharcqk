{
  "name": "themharcqk-profile",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub profile README with a local Markdown preview and linting workflow.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "node scripts/preview-server.mjs",
    "lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\""
  },
  "devDependencies": {
    "github-markdown-css": "^5.8.1",
    "markdownlint-cli2": "^0.14.0",
    "marked": "^14.1.3"
  }
}
